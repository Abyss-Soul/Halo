# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS: Finder metadata, resource forks, and volume metadata
.DS_Store
.AppleDouble/
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.TemporaryItems/
.DocumentRevisions-V100/
.VolumeIcon.icns

# Linux: desktop metadata, trash, NFS temporary files, and backups
.directory
.Trash-*/
.nfs*
*~

# Windows: Explorer thumbnails, desktop metadata, and recycle bins
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
System Volume Information/

# C / C++ / Rust: compiled objects, libraries, executables, and debug data
*.o
*.obj
*.lo
*.a
*.lib
*.la
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app/
*.idb
*.ilk
*.exp
*.pch
*.gch
*.dSYM/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Rust: additional compiled library artifacts
*.rlib
*.rmeta
# Keep Cargo.lock tracked for reproducible application builds.

# Python: bytecode, virtual environments, package output, and tool caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
__pypackages__/
.Python
pip-wheel-metadata/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# CMake: build trees and files generated by in-source builds
build/
_build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
CPackConfig.cmake
CPackSourceConfig.cmake
_CPack_Packages/
compile_commands.json
CMakeUserPresets.json
# Keep CMakeLists.txt, CMakePresets.json, and hand-written Makefiles tracked.

# Ninja: generated build descriptions, dependency databases, and logs
build.ninja
rules.ninja
.ninja_deps
.ninja_log

# Cargo: local caches and installed tools (including nested projects)
**/.cargo/registry/
**/.cargo/git/
**/.cargo/bin/
**/.cargo/.crates.toml
**/.cargo/.crates2.json
**/.cargo/.package-cache*
**/.cargo/.global-cache*

# Cargo: local registry credentials (current and legacy filenames)
**/.cargo/credentials.toml
**/.cargo/credentials

# Cargo: packaged crate archives
*.crate

# Keep Cargo.toml, Cargo.lock, rust-toolchain.toml, and .cargo/config.toml tracked.
